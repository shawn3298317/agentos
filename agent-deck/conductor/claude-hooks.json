{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|compact|clear",
        "hooks": [ { "type": "command", "command": "\"$HOME/.local/bin/agentos-conductor-hook\"", "timeout": 20 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "\"$HOME/.local/bin/agentos-conductor-hook\"", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"$HOME/.local/bin/agentos-conductor-hook\"", "timeout": 20 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "\"$HOME/.local/bin/agentos-conductor-hook\"", "timeout": 10 } ] }
    ]
  }
}
