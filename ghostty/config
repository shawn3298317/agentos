# ── Ghostty Config (managed by agentos; symlinked to ~/.config/ghostty/config) ──

# Theme
theme = Catppuccin Mocha

# ── Font ────────────────────────────────────────────────────────────────────
# Installed by the Brewfile (cask font-jetbrains-mono).
font-family = "JetBrains Mono"
font-size = 12
font-feature = calt
font-feature = liga

# ── Cursor ──────────────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = true
cursor-color = #cdd6f4

# ── Window ──────────────────────────────────────────────────────────────────
background-opacity = 0.95
background-blur-radius = 20
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
macos-titlebar-style = tabs
macos-option-as-alt = true
# Reopen windows/tabs/splits after a restart.
window-save-state = always

# ── Scrollback ──────────────────────────────────────────────────────────────
scrollback-limit = 10000

# ── Mouse ───────────────────────────────────────────────────────────────────
mouse-hide-while-typing = true
mouse-scroll-multiplier = 3
focus-follows-mouse = true

# ── Splits ──────────────────────────────────────────────────────────────────
unfocused-split-opacity = 0.7
window-inherit-working-directory = true

# ── Behavior ────────────────────────────────────────────────────────────────
confirm-close-surface = false
quit-after-last-window-closed = true
bold-is-bright = true

# ── Clipboard / Copy-Paste ──────────────────────────────────────────────────
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true

# ── URL / Link Handling ─────────────────────────────────────────────────────
link-url = true

# ── Shell Integration ────────────────────────────────────────────────────────
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ── Key Bindings ─────────────────────────────────────────────────────────────
# Split panes
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+w=close_surface
keybind = super+shift+enter=toggle_split_zoom

# Navigate splits
keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+alt+up=goto_split:top
keybind = super+alt+down=goto_split:bottom

# Tabs
keybind = super+t=new_tab
keybind = super+shift+[=previous_tab
keybind = super+shift+]=next_tab

# Font size (bump quickly when someone is reading over your shoulder)
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+0=reset_font_size

# Clear scrollback
keybind = super+k=clear_screen

# ── agentos shortcuts ────────────────────────────────────────────────────────
# Cmd+Shift+A: open the agent-deck TUI in the current shell.
keybind = super+shift+a=text:agent-deck\r
# Cmd+Shift+S: fleet status and health check.
keybind = super+shift+s=text:agentos status\r
