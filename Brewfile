brew "gh"                   # PRs from worktree sessions
brew "node"
brew "ripgrep"
brew "fd"
brew "terminal-notifier"    # local escalation notifications (no Telegram on a loaner)
brew "asheshgoplani/tap/agent-deck"

cask "ghostty"
